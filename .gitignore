# ── Dependencies ──────────────────────────────────────────────────────────────
# "node_modules" contains every installed package. It can be 100,000+ files
# and hundreds of MB. Never commit it — anyone can recreate it with "npm install".
node_modules/

# ── Environment files ─────────────────────────────────────────────────────────
# .env holds your real API keys and database credentials. If this ends up on
# GitHub, those are exposed to the entire internet. The .env.example file (no
# real values) IS safe to commit — it tells others what variables they need.
.env
.env*.local

# ── Generated build output ────────────────────────────────────────────────────
.next/
out/
build/
dist/

# ── Prisma ─────────────────────────────────────────────────────────────────────
prisma/generated/

# ── Test / coverage output ────────────────────────────────────────────────────
coverage/

# ── Operating system files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor files ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo

# ── TypeScript / Next build artifacts ─────────────────────────────────────────
next-env.d.ts
*.tsbuildinfo
