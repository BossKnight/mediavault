// Prisma schema for MediaVault.
//
// Two-table split at the heart of the app:
//   - MediaItem is global, shared metadata pulled from TMDB / RAWG / Open
//     Library. It exists once per external title regardless of how many
//     users have catalogued it.
//   - UserMediaProgress is the per-user join row: status, rating, notes, and
//     type-specific fields (owned seasons for TV, hours played for games,
//     and a shared list of physical formats / platforms).
//
// This keeps external metadata de-duplicated and lets user-specific data (a
// rating, a review) live independently of the shared title record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  TV
  GAME
  BOOK
}

enum MetadataSource {
  TMDB
  RAWG
  OPENLIBRARY
}

enum WatchStatus {
  PLAN_TO_WATCH
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  DROPPED
}

// Ownership is a separate axis from WatchStatus: a wishlist item is
// something the user wants to own but doesn't yet, which is a different
// question from how far along they are with something they do own.
enum OwnershipStatus {
  OWNED
  WISHLIST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  progress UserMediaProgress[]
}

model MediaItem {
  id          String         @id @default(cuid())
  source      MetadataSource
  externalId  String
  mediaType   MediaType
  title       String
  releaseDate DateTime?
  coverUrl    String?
  overview    String?
  genres      String[]
  // Director (movie), showrunner/network (TV), or developer (game).
  creator     String?
  // Book only — the barcode-lookup key. Never set for other media types.
  isbn        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  progress UserMediaProgress[]

  // The same external title should never be stored twice. mediaType is part
  // of the key because TMDB numbers movies and TV shows separately: movie 1399
  // and show 1399 are different titles with the same source and id.
  @@unique([source, mediaType, externalId])
  @@index([mediaType])
}

model UserMediaProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  status      WatchStatus @default(PLAN_TO_WATCH)
  rating      Int? // 1-5, user's personal rating
  reviewNotes String?

  // TV-specific ownership. This app catalogs what you own, not viewing
  // progress, so a mismatched collection (e.g. owning seasons 1, 2, and 6
  // of a show) is recorded explicitly rather than as a single "up to"
  // season number. completeSeries is a shortcut for "every season."
  ownedSeasons   Int[]
  completeSeries Boolean @default(false)

  // Movie/TV physical formats (VHS, DVD, Blu-Ray, 4K UHD), book formats
  // (Hardcover, Paperback...), and game platforms (PS5, PC, Switch...) share
  // this column; a title owned in several is one entry listing all of them.
  platforms String[] @default([])
  // Legacy single value from before `platforms`. Kept so adding the list is
  // a purely additive migration; it's read as a fallback (see
  // lib/platforms.ts) and cleared the next time the entry is saved.
  platform  String?

  // Game-specific progress.
  hoursPlayed Float?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Whether the user owns this title or just wants to. Kept separate from
  // status: a wishlist item still defaults to PLAN_TO_WATCH so it behaves
  // sensibly once promoted, but is never surfaced as owned until then.
  ownership OwnershipStatus @default(OWNED)

  // The physical copies owned (vault entries only). While an entry has
  // none, its copies are read from the older platforms / platform /
  // ownedSeasons / completeSeries fields above (lib/copies.ts); saving
  // copies clears those, so each entry converts the first time it's saved.
  copies Copy[]

  // One progress row per user per title.
  @@unique([userId, mediaItemId])
  @@index([userId, status])
  @@index([userId, ownership])
}

// Fixed-window request counters for rate limiting (see lib/rate-limit.ts).
// Kept in Postgres rather than process memory so every app instance shares
// the same counts. `key` combines the action and the client, for example
// "login:203.0.113.7" or "barcode:<userId>".
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// One physical copy of a title: a format or platform, an optional edition,
// and for a TV show, the seasons it holds. An entry's platforms and
// seasons owned are worked out from its copies.
model Copy {
  id         String            @id @default(cuid())
  progressId String
  progress   UserMediaProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  // "Blu-Ray", "4K UHD", "Switch"; null when not recorded.
  format         String?
  // "Collector's Edition", free text.
  edition        String?
  // TV only.
  seasons        Int[]   @default([])
  completeSeries Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([progressId])
}
