# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/mediavault
DATABASE_URL=

# Random secret used to sign NextAuth session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Get a free TMDB API key (v3 auth) at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Get a free RAWG API key at: https://rawg.io/apidocs (click "Get API Key")
RAWG_API_KEY=
