# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/mediavault
DATABASE_URL=

# Random secret used to sign NextAuth session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Get a free TMDB API key (v3 auth) at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Get a free RAWG API key at: https://rawg.io/apidocs (click "Get API Key")
RAWG_API_KEY=

# Books use Open Library, which needs no API key. Barcode scanning also
# calls two optional providers, neither required for the app to work:
#   - UPCitemdb's free trial lookup (movie/TV/game UPCs) — no key, just
#     IP-rate-limited to 100 lookups/day. Nothing to set here.
#   - Google Books (fills in a cover or description Open Library is
#     missing for a given ISBN) — runs unauthenticated at low volume; set
#     a key only to raise that quota. Get one at:
#     https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
